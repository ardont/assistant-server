@echo off
chcp 65001 >nul
title Подключение к HomeServer INBOX
color 0A

echo ==============================================================================
echo            📁 Подключение сетевого диска INBOX к HomeServer
echo ==============================================================================
echo.

:: Отключаем старый диск Z: если был
net use Z: /delete /yes >nul 2>&1

:: Пытаемся подключить по локальной сети Wi-Fi
echo Попытка подключения по локальной сети (192.168.50.108)...
net use Z: \\192.168.50.108\INBOX /persistent:yes >nul 2>&1

if %errorlevel% neq 0 (
    echo [!] По локальному IP не удалось. Попытка через имя хоста...
    net use Z: \\HomeServer\INBOX /persistent:yes >nul 2>&1
)

if %errorlevel% equ 0 (
    echo.
    echo [✓] УСПЕХ! Сетевой диск Z:\ успешно подключен.
    echo Теперь любые файлы, скопированные на диск Z:\, мгновенно обрабатываются ИИ на сервере.
    explorer Z:\
) else (
    echo.
    echo [!] Не удалось подключить автоматически.
    echo Убедитесь, что Ноутбук 1 включен и находится в той же сети Wi-Fi.
)

echo.
pause
