@echo off
chcp 65001 >nul
title HomeServer - Настройка сетевого доступа (SMB)
echo ==========================================================
echo    Настройка общего доступа к папке INBOX для ноутбука
echo ==========================================================
echo.
echo ВНИМАНИЕ: Для выполнения этого файла запустите его от имени Администратора
echo (Правый клик -> "Запуск от имени администратора").
echo.

net share inbox="C:\HomeServer\inbox" /grant:Все,FULL /grant:Everyone,FULL /grant:%USERNAME%,FULL

echo.
echo ----------------------------------------------------------
echo Если команда выполнена успешно, на ноутбуке откройте:
echo \\%COMPUTERNAME%\inbox
echo ----------------------------------------------------------
echo.
pause
