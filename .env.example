# ==============================================================================
# 🌟 HomeServer Multi-Channel AI Hub — Configuration Template
# Скопируйте этот файл в config/.env и заполните своими ключами
# ==============================================================================

# 🧠 Google Gemini API (Основной AI-движок для анализа, чата и мультиагентов)
# Получите бесплатный ключ: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BACKUP_KEY=your_backup_gemini_api_key_here

# ⚡ DeepSeek API (Резервный AI-движок для глубокого кодинга и рассуждений)
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 📢 Мобильные Push-уведомления (ntfy.sh)
# Установите приложение ntfy на телефон и подпишитесь на указанный топик
NTFY_TOPIC=homeserver_your_unique_topic_2026

# 🤖 ВКонтакте Бот (Long Polling)
# 1. Создайте сообщество ВКонтакте -> Управление -> Работа с API -> Создать ключ доступа
# 2. Включите 'Сообщения сообщества' и 'Возможности ботов' в настройках сообщества
VK_BOT_TOKEN=your_vk_group_access_token_here
VK_GROUP_ID=123456789
VK_USER_ID=816140871

# ✈️ Telegram Бот (Long Polling)
# Создайте бота через @BotFather и вставьте токен
TELEGRAM_BOT_TOKEN=

# 💬 MAX Messenger Bot
MAX_BOT_TOKEN=

# 🌐 Cloudflare Tunnel (Бесплатный белый HTTPS адрес без белого IP и проброса портов)
# Оставьте 1 для автоматического запуска cloudflared туннеля
CLOUDFLARE_ENABLED=1

# 🛡️ Прокси для мессенджеров (опционально)
VK_PROXY_URL=
MAX_PROXY_URL=

# 🔄 OmniRoute / Local LLM Gateway (опционально)
OMNIROUTE_URL=http://localhost:2000
OMNIROUTE_API_KEY=
